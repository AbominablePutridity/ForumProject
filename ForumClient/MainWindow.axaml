<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ForumClient.Controls"
        x:Class="ForumClient.MainWindow"
        Title="JCore Forum"
        Width="1280" Height="840"
        MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen">

    <Panel>
        <controls:WebHost x:Name="Web" />

        <Border x:Name="FatalOverlay" IsVisible="False" Background="#FFF8F7">
            <StackPanel Margin="32" VerticalAlignment="Center"
                        HorizontalAlignment="Center" MaxWidth="720">
                <TextBlock Text="Не удалось инициализировать веб-оболочку"
                           FontSize="20" FontWeight="SemiBold" Foreground="#B3261E"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="FatalText" Margin="0,12,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Panel>

</Window>
